{
  "name": "Nachtwache Spielserver",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Nachtwache",
      "onAutoForward": "silent"
    }
  },
  "postAttachCommand": {
    "spielserver": "bash .devcontainer/start.sh"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
